{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "",
  "outputDirectory": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/better-sqlite3/**,data/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
